	#include<bits/stdc++.h>
	#define ll long long
	#define endl "\n"
	#define pll pair<long long,long long>
	#define fi first
	#define se second
	#define MASK(i) (1 << (i))
	#define db double
	#define pii pair<int,int>
	#define pxy pair<double,double>
	#define inf = 1e18
	
	using namespace std;
	
	signed main(){
		#define NAME "diamond"
		if(fopen(NAME".in","r")){
			freopen(NAME".in","r",stdin);
			freopen(NAME".out","w",stdout);
		}
		ios_base::sync_with_stdio(0);
		cin.tie(0);cout.tie(0);
		int n,k;cin >> n >> k;
		int a[n+5];
		for(int i = 1;i<=n;i++)	cin >> a[i];
		sort(a+1,a+n+1);
		// for(int i = 1;i<=n;i++) cout << a[i] << " ";
		int l = 1;
		int ans = 1;
		int left[n+5];
		int right[n+5];
		for(int i = 1;i<=n;i++) left[i] = right[i] = 1;
		for(int r = 2;r<=n;r++){
			while(a[r] - a[l] > k && l < r) l++;
			left[r] = max(left[r-1],r-l+1);
			// cout << r-l+1 << " ";
		}
		int r = n;
		// cout << endl;
		for(int l = n-1;l>=1;l--){
			while(a[r]-a[l] > k && l < r) r--;
			right[l] = r-l+1;
			right[l] = max(right[l+1],r-l+1);
			// cout << r-l+1 << " ";
		}
		for(int i = 2;i<=n;i++) ans = max(ans,left[i-1] + right[i]);
		for(int i = 1;i<n;i++) ans = max(ans,left[i]+right[i+1]);
		cout << ans;
		cerr << endl << "Time elapsed: " << 1.0 * clock() / CLOCKS_PER_SEC << " s.\n";
		return 0;
	}
